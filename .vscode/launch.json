{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug J-Link (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Gimbal_V1.1.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "/usr/bin/openocd",
            "gdbPath": "/home/yorkuy/.local/share/stm32cube/bundles/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "device": "STM32F405RG",
            "svdFile": "/home/yorkuy/.local/share/stm32cube/packs/STMicroelectronics/stm32f4xx_dfp/1.2.0/SVD/STM32F405.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw",
            "postAttachCommands": [
                "monitor reset init",
                "handle SIGTRAP nostop noprint",
                "handle SIGINT nostop noprint"
            ]
        }
    ]
}
